{
  "name": "@flowing-day/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "dev": "pnpm --filter @flowing-day/docs dev",
    "test": "pnpm -r --if-present test",
    "test:ui": "pnpm typecheck:ui && playwright test --config playwright.ui.config.ts --headed",
    "test:ui:headless": "pnpm typecheck:ui && playwright test --config playwright.ui.config.ts",
    "typecheck:ui": "tsc -p ui-tests/tsconfig.json --noEmit",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "benchmark:canvas": "pnpm --filter @flowing-day/canvas-benchmarks benchmark",
    "manifest": "pnpm --filter @flowing-day/ui manifest",
    "tokens:swift": "node ../scripts/generate-swift-theme.mjs",
    "tokens:check": "node ../scripts/generate-swift-theme.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  }
}
