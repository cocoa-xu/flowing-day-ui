{
  "name": "@flowing-day/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @flowing-day/ui build",
    "dev": "pnpm --filter @flowing-day/docs dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "manifest": "pnpm --filter @flowing-day/ui manifest",
    "tokens:swift": "node ../scripts/generate-swift-theme.mjs",
    "tokens:check": "node ../scripts/generate-swift-theme.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "5.9.3"
  }
}
