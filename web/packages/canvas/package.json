{
  "name": "@flowing-day/canvas",
  "version": "0.2.1",
  "description": "A framework-agnostic infinite canvas matching FlowingDayCanvas for SwiftUI.",
  "license": "Apache-2.0",
  "author": "Cocoa <i@uwucocoa.moe>",
  "homepage": "https://github.com/cocoa-xu/flowing-day-ui/tree/main/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocoa-xu/flowing-day-ui.git",
    "directory": "web/packages/canvas"
  },
  "bugs": "https://github.com/cocoa-xu/flowing-day-ui/issues",
  "keywords": [
    "canvas",
    "infinite-canvas",
    "web-components",
    "swiftui",
    "pan",
    "zoom"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/components/**",
    "./dist/index.js",
    "**/*.css"
  ],
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types && pnpm run manifest",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "manifest": "cem analyze --litelement",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:exports": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
