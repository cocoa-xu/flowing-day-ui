{
  "name": "@flowing-day/ui",
  "version": "0.1.0",
  "description": "Framework-agnostic web components mirroring the FlowingDayUI SwiftUI design toolkit.",
  "license": "Apache-2.0",
  "author": "Cocoa <i@uwucocoa.moe>",
  "homepage": "https://github.com/cocoa-xu/flowing-day-ui/tree/main/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocoa-xu/flowing-day-ui.git",
    "directory": "web/packages/core"
  },
  "bugs": "https://github.com/cocoa-xu/flowing-day-ui/issues",
  "keywords": [
    "web-components",
    "custom-elements",
    "design-system",
    "design-tokens",
    "lit",
    "preferences",
    "swiftui",
    "macos",
    "framework-agnostic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/components/**",
    "./dist/index.js",
    "**/*.css"
  ],
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types && pnpm run build:theme && pnpm run manifest",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json && node scripts/copy-token-source.js",
    "build:theme": "node scripts/emit-theme-css.js",
    "manifest": "cem analyze --litelement",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:exports": "publint && attw --pack . --profile esm-only --exclude-entrypoints theme.css"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^24.13.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
