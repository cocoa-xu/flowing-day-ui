      }
    },

    {
      "title": "Accent — one colour, adapted per appearance (FlowingAccent.celadon)",
      "source": "FlowingAccent.celadon",
      "note": "An accent is one colour, not four. The four literals FlowingAccent.celadon spells out are a single hue at four lightnesses: the fill lifts by 0.131 for dark surfaces, and the foreground steps away from the surface it sits on — down 0.114 on light, up 0.030 on dark. That makes the accent a single knob adapting to both appearances, which is what a caller wants when they say \"make it copper\". Each derived token stays individually overridable for anyone who needs to art-direct one appearance by hand.",
      "swiftAlignment": "The derivation is the source on both platforms; FlowingAccent is being changed to derive rather than to spell out. Measured against the literals it replaces, worst channel delta is 3/255 — fill light #6D9EA5 exact, fill dark #93C8CF→#95C7CF, foreground light #4E7B82→#4B7C82, foreground dark #9FD1D8→#9ED1D9. An emitter must therefore write the lift and contrast steps to Swift, not four resolved colours.",
      "tokens": {
        "accent": { "ref": "accent-celadon" },
        "accent-lift": {
          "number": { "light": 0, "dark": 0.131 },
          "note": "Only the two lightness steps depend on the appearance. Keeping the formulas themselves appearance-independent is what lets --fd-accent be set at any depth: a derived token substituted high up would be frozen for everything below it."
        },
        "accent-contrast": { "number": { "light": -0.114, "dark": 0.03 } },
        "accent-fill": {
          "css": "oklch(from var(--fd-accent) calc(l + var(--fd-accent-lift)) c h)"
        },
        "accent-foreground": {
          "css": "oklch(from var(--fd-accent-fill) calc(l + var(--fd-accent-contrast)) c h)"
        },
        "accent-wash": { "css": "color-mix(in srgb, var(--fd-accent-fill) 13%, transparent)" },
        "accent-veil": { "css": "color-mix(in srgb, var(--fd-accent-fill) 8%, transparent)" }
      }
    },

    {
      "title": "Named accents — FlowingNamedAccentBase",
      "source": "FlowingNamedAccentBase",
      "expand": "namedAccents"
    },

    {
      "title": "Metrics — FlowingMetrics.standard / PreferencesMetrics.standard",
      "source": "FlowingMetrics.standard / PreferencesMetrics.standard",
      "tokens": {
        "metric-card-radius": { "px": 14, "swift": "FlowingMetrics.standard" },
        "metric-control-radius": { "px": 9, "swift": "FlowingMetrics.standard" },
        "metric-row-inset": { "px": 18, "swift": "FlowingMetrics.standard" },
        "metric-content-width": { "px": 720, "swift": "PreferencesMetrics.standard" },
        "metric-section-spacing": { "px": 20, "swift": "PreferencesMetrics.standard" }
      }
    },

    {
      "title": "Font families — FlowingFontDesign",
      "source": "FlowingFontDesign",
      "note": ".rounded and .serif resolve to SF Pro Rounded / New York on Apple platforms only. The fallback chains keep the intent recognisable everywhere else, and are therefore CSS-only: Swift names a design, not a stack.",
      "tokens": {
        "font-standard": {
          "css": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif"
        },
        "font-rounded": {
          "css": "ui-rounded, \"SF Pro Rounded\", \"Hiragino Maru Gothic ProN\", \"Varela Round\", -apple-system, system-ui, sans-serif"
        },
        "font-serif": { "css": "ui-serif, \"New York\", Georgia, \"Times New Roman\", serif" },
        "font-monospaced": {
          "css": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace"
        }
      }
    },

    {
      "title": "Text roles — FlowingTypography.standard",
      "source": "FlowingTypography.standard",
      "expand": "typography"
    },

    {
      "title": "Motion — literal durations from the SwiftUI sources",
      "source": null,
      "note": "Not from FlowingTheme.swift: these are the literals written into the view sources, each cited on the token.",
      "tokens": {
        "motion-disclosure": {
          "ms": 180,
          "swift": "PreferencesDependentRowsMotion.standardDuration"
        },
        "motion-disclosure-offset": {
          "px": -5,
          "swift": "PreferencesDependentRowsMotion.detailOffset"
        },
        "motion-expand": {
          "ms": 180,
          "swift": "PreferencesExpandableRow, PreferencesSearchPickerRow",
          "note": "Same 0.18s as the disclosure, but a different reduce-motion branch: the expandable rows pass `nil` rather than shortening, so this collapses to nothing."
        },
        "motion-hover": { "ms": 120, "swift": "PreferencesSidebarItem, PreferencesSelectableTag" },
        "motion-selection": { "ms": 160, "swift": "PreferencesSelectableTag" },
        "motion-page": { "ms": 220, "swift": "PreferencesDetailPane" },
        "motion-default": {
          "ms": 350,
          "swift": ".default",
          "note": "SwiftUI `.default`, which the selection buttons animate their tint with."
        },
        "motion-easing": { "css": "cubic-bezier(0, 0, 0.58, 1)", "swift": ".easeOut" },
        "motion-easing-page": { "css": "cubic-bezier(0.42, 0, 0.58, 1)", "swift": ".easeInOut" }
      }
    },

    {
      "title": "Control chrome — knob treatment shared by switch and slider",
      "source": "FlowingPalette",
      "tokens": {
        "knob-fill": {
          "color": { "light": "FFFFFF", "dark": "E2E2DE" },
          "swift": "FlowingPalette.sliderKnobColor"
