        "surface-sidebar": { "ref": "palette-card", "swift": "PreferencesSurfaces.standard" },
        "surface-card": { "ref": "palette-control", "swift": "FlowingSurfaces.standard" },
        "surface-control": { "ref": "palette-control", "swift": "FlowingSurfaces.standard" },
