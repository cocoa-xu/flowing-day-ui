  "reducedMotion": {
    "$note": "Reduce Motion collapses the disclosure animation to 0.12s linear and disables the rest outright, matching every accessibilityReduceMotion branch in the Swift source.",
    "motion-disclosure": { "ms": 120 },
    "motion-disclosure-offset": { "px": 0 },
    "motion-expand": { "ms": 1 },
    "motion-hover": { "ms": 1 },
    "motion-selection": { "ms": 1 },
    "motion-page": { "ms": 1 },
    "motion-easing": { "css": "linear" },
    "motion-easing-page": { "css": "linear" }
