        "knob-border": {
          "color": { "light": "000000", "dark": "000000" },
          "alpha": { "light": 0.12, "dark": 0.42 },
          "swift": "FlowingPalette.sliderKnobBorderColor"
        },
        "knob-shadow": {
          "css": "0 -0.5px 1.5px rgb(0 0 0 / 0.16)",
          "swift": "FlowingSliderControl.draw(_:)"
        },
        "track-off": {
          "color": { "light": "E3E3E1", "dark": "48484A" },
          "platform": "web",
          "note": "No Swift counterpart: Toggle(.switch) renders native AppKit chrome, which publishes no colours. Exposed as a token for tuning."
        }
